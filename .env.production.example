# Production settings for the free setup in docs/DEPLOYMENT.md (Vercel Hobby + Neon Free + Brevo Free).
#
# Two places use these values:
#   1. Vercel → Project → Settings → Environment Variables (the running app).
#   2. A local file named .env.production (copy of this file, never committed) for the
#      one-off commands you run from your own computer:
#        pnpm prod:migrate             apply database migrations to Neon
#        pnpm prod:institution:setup   create LASU, faculties, departments, campus, session, semesters
#        pnpm prod:admin:bootstrap     invite the first administrator
#
# Never commit real values. .env.production is already git-ignored.

NODE_ENV=production

# Serve /api/v1 from the same Vercel deployment (no second server needed).
API_MODE=embedded

# Neon → your project → Connect → choose "Pooled connection" and copy the URL.
# It looks like postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Neon pauses after 5 idle minutes; the first request then waits a moment while it wakes.
DATABASE_CONNECT_TIMEOUT_MS=10000

# Your Vercel production address, with https:// and no trailing slash.
# On Vercel it falls back to the project's production domain if left empty.
PUBLIC_APP_URL=https://your-project.vercel.app

# Must match "institution.slug" in config/institution.json.
SELF_REGISTRATION_INSTITUTION_SLUG=lasu

# Security. Keep these as they are.
RATE_LIMIT_STORE=postgres
TRUSTED_ORIGINS=
LOG_LEVEL=info
LOCAL_DEMO_MODE=false

# Email (required: sign-up confirmation, password reset and staff invitations). Pick ONE option.
#
# Option A - Brevo (recommended: free, 300/day, sends to anyone, no domain needed, works over HTTPS):
#   1. Create a free account at https://www.brevo.com
#   2. Verify the sender address: Settings -> Senders, Domains & Dedicated IPs -> Senders.
#   3. Create an API key: Settings -> SMTP & API -> API Keys. It starts with xkeysib- (not the SMTP key).
#   4. Turn OFF IP blocking: https://app.brevo.com/security/authorised_ips -> Deactivate blocking
#      (Vercel has no fixed IP address).
#   Then test it: pnpm prod:email:test --to you@example.com
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=LASUATOS
#
# Optional: who is emailed when something breaks (server errors, page crashes, database
# behind the code). Comma separated. Leave empty to only log problems.
ALERT_EMAIL=
#
# Option B - Gmail (free, about 500 emails/day, no domain needed; some networks block its mail port):
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords (name it LASUATOS)
# EMAIL_PROVIDER=gmail
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# EMAIL_FROM_ADDRESS defaults to GMAIL_USER.
#
# Option C - Resend (free, 100/day). Only works for real users after you verify a DOMAIN you own
# in Resend; without one, Resend delivers only to your own Resend login address.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=noreply@your-verified-domain.com
