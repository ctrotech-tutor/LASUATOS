# Production settings for the free setup in docs/DEPLOYMENT.md (Vercel Hobby + Neon Free + Brevo Free).
#
# Two places use these values:
#   1. Vercel → Project → Settings → Environment Variables (the running app).
#   2. A local file named .env.production (copy of this file, never committed) for the
#      one-off commands you run from your own computer:
#        pnpm prod:migrate             apply database migrations to Neon
#        pnpm prod:institution:setup   create LASU, faculties, departments, campus, session, semesters
#        pnpm prod:admin:bootstrap     invite the first administrator
#
# Never commit real values. .env.production is already git-ignored.

NODE_ENV=production

# Serve /api/v1 from the same Vercel deployment (no second server needed).
API_MODE=embedded

# Neon → your project → Connect → choose "Pooled connection" and copy the URL.
# It looks like postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Neon pauses after 5 idle minutes; the first request then waits a moment while it wakes.
DATABASE_CONNECT_TIMEOUT_MS=10000

# Your Vercel production address, with https:// and no trailing slash.
# On Vercel it falls back to the project's production domain if left empty.
PUBLIC_APP_URL=https://your-project.vercel.app

# Must match "institution.slug" in config/institution.json.
SELF_REGISTRATION_INSTITUTION_SLUG=lasu

# Security. Keep these as they are.
RATE_LIMIT_STORE=postgres
TRUSTED_ORIGINS=
LOG_LEVEL=info
LOCAL_DEMO_MODE=false

# Email (required: sign-up confirmation, password reset and staff invitations).
# Brevo free: 300 emails/day, no card. Brevo → Settings → Senders → add and verify your sender,
# then SMTP & API → API Keys → Generate. EMAIL_FROM_ADDRESS must be that verified sender.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=LASUATOS

# Alternative free option: Gmail with an App Password (needs 2-Step Verification on the account).
# EMAIL_PROVIDER=gmail
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
