# Copy this file to .env for local development only.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
LOG_LEVEL=info

# Docker Compose defaults for a loopback-only PostgreSQL service.
# These credentials are intentionally weak and must never be used outside this local demo.
POSTGRES_DB=lasuatos_dev
POSTGRES_USER=lasuatos_dev
POSTGRES_PASSWORD=lasuatos_dev_only
POSTGRES_PORT=5433
DATABASE_URL=postgresql://lasuatos_dev:lasuatos_dev_only@127.0.0.1:5433/lasuatos_dev

# This is a clearly labelled local test tenant, not a seeded LASU institutional record.
LOCAL_DEMO_MODE=true
SELF_REGISTRATION_INSTITUTION_SLUG=lasuatos-local-demo
PUBLIC_APP_URL=http://localhost:3000

# Local email is captured by Mailpit at http://localhost:8025.
# No message is sent to a real mailbox while EMAIL_PROVIDER=mailpit.
EMAIL_PROVIDER=mailpit
EMAIL_FROM_ADDRESS=lasuatos@example.net
EMAIL_FROM_NAME=LASUATOS Local Demo
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Optional external email providers for a separately approved development setup.
# Gmail through Nodemailer: use OAuth2 or an eligible Google App Password.
# Never use a regular Google account password here.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Brevo sender must be verified with Brevo.
BREVO_API_KEY=

# Resend sender domain must be verified with the DNS records Resend provides.
RESEND_API_KEY=
