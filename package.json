{
  "name": "lasuatos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- pnpm --parallel --filter @lasuatos/api --filter @lasuatos/web dev",
    "dev:setup": "dotenv -e .env -- node scripts/dev-setup.mjs",
    "build": "dotenv -e .env -- node scripts/build.mjs",
    "typecheck": "pnpm --filter @lasuatos/contracts typecheck && pnpm --filter @lasuatos/auth typecheck && pnpm --filter @lasuatos/verification typecheck && pnpm --filter @lasuatos/database typecheck && pnpm --filter @lasuatos/api typecheck && pnpm --filter @lasuatos/web typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @lasuatos/database db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @lasuatos/database db:migrate",
    "db:seed:local": "dotenv -e .env -- pnpm --filter @lasuatos/database db:seed:local",
    "admin:bootstrap": "dotenv -e .env -- pnpm --filter @lasuatos/api admin:bootstrap",
    "institution:setup": "dotenv -e .env -- pnpm --filter @lasuatos/api institution:setup",
    "email:test": "dotenv -e .env -- pnpm --filter @lasuatos/api email:test",
    "load:embedded": "pnpm --filter @lasuatos/api load:embedded",
    "load:lecture": "dotenv -e .env -- node scripts/load/lecture-burst.mjs",
    "prod:migrate": "dotenv -e .env.production -- pnpm --filter @lasuatos/database db:migrate",
    "prod:institution:setup": "dotenv -e .env.production -- pnpm --filter @lasuatos/api institution:setup",
    "prod:admin:bootstrap": "dotenv -e .env.production -- pnpm --filter @lasuatos/api admin:bootstrap",
    "prod:email:test": "dotenv -e .env.production -- pnpm --filter @lasuatos/api email:test",
    "prod:check": "dotenv -e .env.production -- node scripts/prod-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.19.3",
    "dotenv-cli": "11.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
