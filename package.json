{
  "name": "lasuatos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- corepack pnpm --parallel --filter @lasuatos/api --filter @lasuatos/web dev",
    "build": "dotenv -e .env -- node scripts/build.mjs",
    "typecheck": "corepack pnpm --filter @lasuatos/contracts typecheck && corepack pnpm --filter @lasuatos/auth typecheck && corepack pnpm --filter @lasuatos/database typecheck && corepack pnpm --filter @lasuatos/api typecheck && corepack pnpm --filter @lasuatos/web typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "corepack pnpm --filter @lasuatos/database db:generate",
    "db:migrate": "dotenv -e .env -- corepack pnpm --filter @lasuatos/database db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.19.3",
    "dotenv-cli": "11.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
