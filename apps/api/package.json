{
  "name": "@lasuatos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./embedded": {
      "types": "./embedded.d.ts",
      "default": "./dist/embedded.mjs"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json",
    "admin:bootstrap": "tsx src/staff/bootstrap-cli.ts",
    "institution:setup": "tsx src/institution/setup-cli.ts",
    "email:test": "tsx src/email/test-cli.ts",
    "load:embedded": "tsx src/load/embedded-burst.ts",
    "bundle:embedded": "node scripts/bundle-embedded.mjs"
  },
  "dependencies": {
    "@lasuatos/auth": "workspace:*",
    "@lasuatos/contracts": "workspace:*",
    "@lasuatos/database": "workspace:*",
    "@lasuatos/verification": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "nodemailer": "10.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
